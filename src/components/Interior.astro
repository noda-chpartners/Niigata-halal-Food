---
import { Image } from 'astro:assets';

import diningRoom from '../assets/IMG_4906.jpg';
import privateRoom from '../assets/IMG_4905.jpg';

const photos = [
  {
    src: diningRoom,
    alt: '窓際にテーブル席が並ぶ店内',
    caption: 'テーブル席',
    modifier: 'interior-main',
  },
  {
    src: privateRoom,
    alt: 'シャンデリアのある個室',
    caption: '個室',
    modifier: 'interior-side',
  },
];
---

<section class="section interior-section" id="interior">
  <div class="section-inner">
    <div class="section-title fade-in">
      <h2 class="title">INTERIOR</h2>
      <p class="interior-lead">窓際のテーブル席と、少人数で過ごせる個室があります。</p>
    </div>
    <div class="interior-gallery">
      {photos.map((photo, index) => (
        <figure class={`interior-card ${photo.modifier} fade-in fade-in-delay-${index + 1}`}>
          <Image class="interior-img" src={photo.src} alt={photo.alt} />
          <figcaption class="interior-caption">{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .interior-section {
    background-color: $color-white;
  }

  .interior-lead {
    max-width: 40em;
    padding-top: 16.0px;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    letter-spacing: 0.08em;
    line-height: 1.8;
    color: $color-text;
  }

  .interior-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr);
    gap: 24.0px;
    align-items: stretch;
  }

  .interior-card {
    position: relative;
    margin-top: 0;
    margin-left: 0;
    min-height: 520.0px;
    overflow: hidden;
    border-radius: 4.0px;
    transition: transform $transition-fast, box-shadow $transition-fast;

    &:hover {
      transform: translateY(-6.0px);
      box-shadow: 0 12.0px 32.0px rgba($color-primary, 0.2);

      .interior-img {
        transform: scale(1.04);
      }
    }
  }

  .interior-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .interior-main .interior-img {
    object-position: center center;
  }

  .interior-side .interior-img {
    object-position: center 68%;
  }

  .interior-caption {
    position: absolute;
    left: 16.0px;
    bottom: 16.0px;
    padding-top: 8.0px;
    padding-left: 14.0px;
    padding-bottom: 8.0px;
    padding-right: 14.0px;
    background-color: rgba($color-primary, 0.88);
    color: $color-white;
    font-size: 1.2rem;
    letter-spacing: 0.18em;
  }

  @include mobile {
    .interior-gallery {
      grid-template-columns: 1fr;
      gap: 16.0px;
    }

    .interior-main {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .interior-side {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }
</style>
