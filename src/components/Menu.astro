---
import { Image } from 'astro:assets';

import dinnerSet from '../assets/IMG_4911.jpg';
import curry from '../assets/IMG_4912.jpg';
import tandoori from '../assets/IMG_4913.jpg';
import salad from '../assets/IMG_4907.jpg';
import nanRice from '../assets/IMG_4908.jpg';
import dessert from '../assets/IMG_4910.jpg';

const menuItems = [
  { src: dinnerSet, alt: 'ディナーセット' },
  { src: curry, alt: 'チキンカレー・マトンカレー' },
  { src: tandoori, alt: 'タンドーリ' },
  { src: salad, alt: 'サラダ' },
  { src: nanRice, alt: 'ナン・ライス・ピクルス' },
  { src: dessert, alt: 'デザート' },
];
---

<section class="section menu-section" id="menu">
  <div class="section-inner">
    <div class="section-title fade-in">
      <h2 class="title">MENU</h2>
      <p class="menu-lead">
        新潟市中央区米山のハラルレストランです。チキンカレー、マトンカレー、タンドーリ、ナン、サラダ、デザートをご用意しています。
      </p>
    </div>
    <div class="menu-list">
      {menuItems.map((item, index) => (
        <div class={`menu-item fade-in fade-in-delay-${Math.min(index + 1, 5)}`}>
          <Image class="menu-item-img" src={item.src} alt={item.alt} />
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .section-inner {
    max-width: 100%;
  }

  .menu-section {
    background-color: $color-text-light;
  }

  .menu-lead {
    max-width: 40em;
    padding-top: 16.0px;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    letter-spacing: 0.08em;
    line-height: 1.8;
    color: $color-text;
  }

  .menu-list {
    display: flex;
    justify-content: center;
    flex-direction: column;
    width: 100%;
    gap: 30.0px;
  }

  .menu-item {
    overflow: hidden;
    border-radius: 4.0px;
    transition: transform $transition-fast, box-shadow $transition-fast;

    &:hover {
      transform: translateY(-6.0px);
      box-shadow: 0 12.0px 32.0px rgba($color-primary, 0.2);
    }
  }

  .menu-item:hover .menu-item-img {
    transform: scale(1.03);
  }

  .menu-item-img {
    width: 100%;
    justify-content: center;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @include mobile {
    .menu-list {
      gap: 20.0px;
    }
  }
</style>
